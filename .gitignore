# MPM intermediate sim artifacts under snapdiff/result dirs
# (particle state .dat and Wavefront .obj meshes; can be hundreds of MB per run)
OptimizationResults/snapdiff_*/**/*.dat
OptimizationResults/snapdiff_*/**/*.obj
Simulation/results/**/*.dat
Simulation/results/**/*.obj

# γ̇ logger raw per-particle dumps (multi-MB per frame); keep summary JSONs only
gamma_dot_runs/**/*.bin
gamma_dot_runs/**/*.dat
gamma_dot_runs/**/timing.json
gamma_dot_runs/**/meta.txt

# Freshness pilot — large intermediate sim files (3+ GB)
freshness/data/*/holdout_mpm/
# Freshness pilot — raw videos (1 GB total, regenerable from IMG_*.JPG + IMG_*.mov sources)
freshness/data/*/IMG_*.mov
